<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robocode_kr10_description</name>
  <version>0.2.0</version>
  <description>KUKA KR 10 R1100 sixx milling cell (URDF/xacro, meshes, ros2_control) for roboCODE. Ported from ClaBirk/ROS2_Gazebo_Moveit_Simulation.</description>
  <maintainer email="noreply@example.com">anonimov94</maintainer>
  <license>GPL-3.0-only</license>
  <author>ClaBirk (original ROS2_Gazebo_Moveit_Simulation)</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
