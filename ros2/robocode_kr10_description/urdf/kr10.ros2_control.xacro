<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    ros2_control for the 6 KR10 axes (position commands).
    sim_mode gz   -> gz_ros2_control/GazeboSimSystem (Gazebo Harmonic)
    sim_mode mock -> mock_components/GenericSystem (no physics; RViz/MoveIt only)
    The original repo mixed joint1.. and joint_1.. names; here everything is joint_1..joint_6.
  -->
  <xacro:macro name="kr10_axis" params="name initial">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="kr10_ros2_control" params="sim_mode initial_positions_file">
    <xacro:property name="init" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>
    <ros2_control name="KR10System" type="system">
      <hardware>
        <xacro:if value="${sim_mode == 'gz'}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:if value="${sim_mode == 'mock'}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
      </hardware>
      <xacro:kr10_axis name="joint_1" initial="${init['joint_1']}"/>
      <xacro:kr10_axis name="joint_2" initial="${init['joint_2']}"/>
      <xacro:kr10_axis name="joint_3" initial="${init['joint_3']}"/>
      <xacro:kr10_axis name="joint_4" initial="${init['joint_4']}"/>
      <xacro:kr10_axis name="joint_5" initial="${init['joint_5']}"/>
      <xacro:kr10_axis name="joint_6" initial="${init['joint_6']}"/>
    </ros2_control>
  </xacro:macro>
</robot>
