<?xml version="1.0"?>
<!--
  KR10 milling cell: enclosure + door, table frame, robot plate, KUKA KR 10 R1100 sixx, tool holder
  and spindle. Ported from ClaBirk/ROS2_Gazebo_Moveit_Simulation (GPL-3.0) to ROS 2 Jazzy +
  Gazebo Harmonic (gz_ros2_control). Frame tree and offsets unchanged:
    world -> tisch (table) -> unterlage (robot plate, +[-0.394 -0.05 1.033]) -> base (+0.045) -> base_link
    link_6 -> flange (tool holder) -> spindle (= "tool" in the original) -> tcp (spindle tip, estimate)

  Args:
    sim_mode   gz   – Gazebo Harmonic, gz_ros2_control (default)
               mock – ros2_control mock_components (RViz / MoveIt without physics)
    controllers_file  absolute path of the ros2_controllers.yaml used by Gazebo
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kr10_cell">

  <xacro:arg name="sim_mode" default="gz"/>
  <xacro:arg name="controllers_file"
             default="$(find robocode_kr10_description)/config/ros2_controllers.yaml"/>
  <xacro:arg name="initial_positions_file"
             default="$(find robocode_kr10_description)/config/initial_positions.yaml"/>
  <xacro:arg name="with_cell" default="true"/>

  <xacro:include filename="$(find robocode_kr10_description)/urdf/kr10_arm.xacro"/>
  <xacro:include filename="$(find robocode_kr10_description)/urdf/kr10.ros2_control.xacro"/>

  <xacro:property name="cell_black" value="${16/255} ${16/255} ${16/255} 1.0"/>
  <xacro:property name="tool_green" value="${40/255} ${246/255} 0 1.0"/>

  <link name="world"/>

  <!-- table frame (Grundgerüst) -->
  <link name="tisch">
    <visual>
      <origin xyz="0.06 -0.05 0.4875" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_dir}/visual/grundgeruest.stl"/></geometry>
      <material name="cell_black"><color rgba="${cell_black}"/></material>
    </visual>
    <collision>
      <origin xyz="0.06 -0.05 0.4875" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_dir}/visual/grundgeruest.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="5791"/>
      <inertia ixx="772.7" ixy="-28.116" ixz="-4.89" iyy="1160.546" iyz="-107.69026" izz="1163.3546"/>
    </inertial>
  </link>
  <joint name="world_to_table" type="fixed">
    <parent link="world"/>
    <child link="tisch"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- robot plate (Unterlage), mesh in mm -->
  <link name="unterlage">
    <visual>
      <geometry><mesh filename="${mesh_dir}/visual/unterlage_mm.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="cell_black"><color rgba="${cell_black}"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_dir}/visual/unterlage_mm.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <mass value="56.39"/>
      <inertia ixx="0.71274898" ixy="0.0" ixz="0.0079274115" iyy="0.68520638" iyz="0.000016803708" izz="1.3497664"/>
    </inertial>
  </link>
  <joint name="tisch_unterlage" type="fixed">
    <parent link="tisch"/>
    <child link="unterlage"/>
    <origin xyz="-0.394 -0.05 1.033" rpy="0 0 0"/>
  </joint>

  <link name="base"/>
  <joint name="unterlage_base" type="fixed">
    <parent link="unterlage"/>
    <child link="base"/>
    <origin xyz="0 0 0.045" rpy="0 0 0"/>
  </joint>

  <xacro:if value="$(arg with_cell)">
    <!-- enclosure (Schutzzelle) and door -->
    <link name="gehause">
      <visual>
        <geometry><mesh filename="${mesh_dir}/visual/gehause_neu_koord.stl"/></geometry>
        <material name="cell_black"><color rgba="${cell_black}"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_dir}/visual/gehause_neu_koord.stl"/></geometry>
      </collision>
      <inertial>
        <mass value="352.997"/>
        <inertia ixx="313.353" ixy="0.634681" ixz="3.475" iyy="289.315" iyz="0.072963" izz="259.39793"/>
      </inertial>
    </link>
    <joint name="world_to_home" type="fixed">
      <parent link="world"/>
      <child link="gehause"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="tuer">
      <visual>
        <geometry><mesh filename="${mesh_dir}/visual/tuer.stl"/></geometry>
        <material name="cell_black"><color rgba="${cell_black}"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_dir}/visual/tuer.stl"/></geometry>
      </collision>
      <inertial>
        <mass value="167.796"/>
        <inertia ixx="15.59" ixy="0.0" ixz="0.0" iyy="23.878954" iyz="0.0" izz="39.451441"/>
      </inertial>
    </link>
    <joint name="house_to_door" type="fixed">
      <parent link="gehause"/>
      <child link="tuer"/>
      <origin xyz="0 0.752 0.495" rpy="0 0 0"/>
    </joint>
  </xacro:if>

  <!-- robot -->
  <xacro:kr10_arm parent="base">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:kr10_arm>

  <!-- tool holder (Werkzeughalter) -->
  <link name="flange">
    <visual>
      <geometry><mesh filename="${mesh_dir}/visual/werkzeughalter_v2.stl"/></geometry>
      <material name="tool_green"><color rgba="${tool_green}"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_dir}/visual/werkzeughalter_v2.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.04 0.046 0.05" rpy="0 0 0"/>
      <mass value="0.67"/>
      <!-- original values were ~1e3 kg m^2 (wrong units); small plausible box inertia -->
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="jointflange" type="fixed">
    <parent link="link_6"/>
    <child link="flange"/>
    <origin xyz="0.01 0.04 -0.053" rpy="0 0 ${-pi/2}"/>
  </joint>

  <!-- spindle ("tool" in the original): Z along the spindle axis -->
  <link name="spindle">
    <visual>
      <geometry><mesh filename="${mesh_dir}/visual/spindel_v1.stl"/></geometry>
      <material name="tool_green"><color rgba="${tool_green}"/></material>
    </visual>
    <collision>
      <!-- the visual mesh has ~100k triangles; a cylinder keeps Gazebo and MoveIt fast -->
      <origin xyz="0 0 0.0865" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.325"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.014" ixy="0" ixz="0" iyy="0.014" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="jointtool" type="fixed">
    <parent link="flange"/>
    <child link="spindle"/>
    <origin xyz="0.04 0.054 0.037" rpy="0 0 ${pi/2}"/>
  </joint>

  <!-- spindle tip, Z pointing into the material (roboCODE tool convention); estimate, measure the real TCP -->
  <link name="tcp"/>
  <joint name="spindle-tcp" type="fixed">
    <parent link="spindle"/>
    <child link="tcp"/>
    <origin xyz="0 0 -0.076" rpy="${pi} 0 0"/>
  </joint>

  <xacro:kr10_ros2_control sim_mode="$(arg sim_mode)" initial_positions_file="$(arg initial_positions_file)"/>

  <xacro:if value="${'$(arg sim_mode)' == 'gz'}">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg controllers_file)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
