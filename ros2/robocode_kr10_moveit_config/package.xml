  <description>MoveIt 2 configuration (OMPL + Pilz) for the roboCODE KR10 milling cell. Ported from ClaBirk kr10zelle_moveit_config.</description>
  <maintainer email="noreply@example.com">anonimov94</maintainer>
  <license>GPL-3.0-only</license>
  <author>ClaBirk (original kr10zelle_moveit_config)</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robocode_kr10_description</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
