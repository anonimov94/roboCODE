DEF Golden ( )
;FOLD INI
  BAS (#INITMOV,0 )
;ENDFOLD
BAS (#VEL_PTP,20)
$ORI_TYPE = #VAR
$CIRC_TYPE = #BASE
$BASE = {X 100.000,Y 200.000,Z 300.000,A 90.0000,B 0.0000,C 0.0000} ; Fixture
$TOOL = {X 0.000,Y 0.000,Z 150.000,A 0.0000,B 0.0000,C 0.0000} ; Spindle
$APO.CDIS = 0.000
$VEL.CP = 0.05000
BAS (#VEL_PTP,20) ; 30 deg/s
PTP {A1 0.0000,A2 10.0000,A3 -20.0000,A4 30.0000,A5 40.0000,A6 -50.0000}
LIN {X 10.000,Y 20.000,Z 30.000,A 45.0000,B 0.0000,C 0.0000} C_DIS
CIRC {X 15.000,Y 25.000,Z 35.000,A 0.0000,B 0.0000,C 0.0000},{X 20.000,Y 30.000,Z 40.000,A 0.0000,B 0.0000,C 0.0000} C_DIS
$APO.CDIS = 5.000
; MSG: Kontrola
$OUT[do1] = TRUE
WAIT FOR $IN[di1] == TRUE
WAIT SEC 0.500
CycleDone()
END
